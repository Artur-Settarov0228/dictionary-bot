# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID (sizning shaxsiy Telegram ID'ingiz)
ADMIN_IDS=

# PostgreSQL ulanish URL (Asinxron)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/your_database_name

# Redis ulanish URL (FSM uchun, ixtiyoriy)
REDIS_URL=redis://localhost:6379/0

# Webhook URL (production serveringizning URL'i)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook

# FastAPI server
HOST=0.0.0.0
PORT=8000
